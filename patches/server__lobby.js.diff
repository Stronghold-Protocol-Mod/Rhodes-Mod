+   * it. The client answers by refetching the data (public/js/ui/modBadge.js), which is why a running match refuses
+   * the switch in the first place (server/mod/api.js).
+   * @param {object} payload the new state (server/mod/api.js)
+   * @returns {number} how many sessions received it
+   */
+  modChanged(payload) {
+    let sent = 0;
+    for (const session of this.registry.byPlayerId.values()) {
+      if (!session || !session.connected) continue;
+      if (sendSession(session, { t: 'mod.state', ...payload })) sent += 1;
+    }
+    return sent;
+  }
