+  /**
+   * Set (or clear) one room's sandbox — the host's test settings for the NEXT match. Called by the loopback-only HTTP
+   * route, never by a `room.*` intent: a sandbox rewrites the match's economy and wave, so it belongs to the machine
+   * running the server (the same rule as the content switch, server/mod/api.js).
+   *
+   * @param {string} code room code
+   * @param {any} raw the request (shared/sandbox.js checkSandbox); null / `{ clear: true }` clears it
+   * @returns {{ ok: true, sandbox: object|null, code: string } | { ok: false, code: string, detail?: string }}
+   */
+  setSandbox(code, raw) {
+    const room = this.getRoom(code);
+    if (!room) return { ok: false, code: 'SANDBOX_ROOM', detail: `no room ${code}` };
+    // 沙盒 · 盟约层数加成 (docs/SANDBOX.md): a running match can still take THIS one field — it is applied live
+    // (MatchIntents.applySandboxBondLayers). Everything else (the economy, the clock, the round count, the wave) is a
+    // property of the match's own construction and stays refused while a match runs.
+    if (room.match) {
+      const live = this._liveSandboxChange(room, raw);
+      if (!live.ok) return live;
+      return { ok: true, sandbox: room.sandbox, code: room.code, live: true };
+    }
+    if (raw == null || raw === '' || (raw && typeof raw === 'object' && raw.clear === true)) {
+      room.sandbox = null;
+      this.broadcastState(room);
+      return { ok: true, sandbox: null, code: room.code };
+    }
+    const checked = checkSandbox(raw, this.safeData());
+    if (!checked.ok) return { ok: false, code: checked.code, detail: checked.detail };
+    // An inert sandbox (nothing overridden) is kept as `null` — the room is exactly an ordinary run.
+    room.sandbox = checked.sandbox.inert ? null : checked.sandbox;
+    this.broadcastState(room);
+    return { ok: true, sandbox: room.sandbox, code: room.code };
+  }
+
+  /**
+   * Apply a sandbox request to a room whose match is already RUNNING. Only 盟约层数加成 may change mid-match (it is a
+   * live layer write, not a construction-time property); any other field — or a clear — is refused with SANDBOX_BUSY,
+   * the same code the pre-match flow used to answer alone.
+   * @param {object} room @param {any} raw
+   * @returns {{ ok: true } | { ok: false, code: string, detail?: string }}
+   */
+  _liveSandboxChange(room, raw) {
+    if (raw == null || raw === '' || (raw && typeof raw === 'object' && raw.clear === true)) {
+      return { ok: false, code: 'SANDBOX_BUSY', detail: 'a match is running; only 盟约层数加成 can change mid-match' };
+    }
+    const keys = raw && typeof raw === 'object' ? Object.keys(raw).filter((k) => k !== 'room') : [];
+    if (!keys.length || keys.some((k) => k !== 'bondLayers')) {
+      return { ok: false, code: 'SANDBOX_BUSY', detail: 'a match is running; only 盟约层数加成 (bondLayers) can change mid-match' };
+    }
+    const checked = checkSandbox({ bondLayers: raw.bondLayers }, this.safeData());
+    if (!checked.ok) return { ok: false, code: checked.code, detail: checked.detail };
+    const gear = checked.sandbox.bondLayers || 0;
+    room.sandbox = room.sandbox ? { ...room.sandbox, bondLayers: gear || null } : { ...EMPTY_SANDBOX, bondLayers: gear || null, inert: false };
+    this.callMatch(room, 'applySandboxBondLayers', gear);
+    return { ok: true };
+  }
