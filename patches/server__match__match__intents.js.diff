+  /**
+   * 沙盒 · 盟约层数加成, live (docs/SANDBOX.md §盟约层数加成; the 「对局内可以更改」 requirement): set the flat bonus every
+   * bond's layers of every seat carries, at once, mid-match. Called by the lobby when the host POSTs /sandbox for a room
+   * whose match is already running (server/lobby.js setSandbox — a sandbox field a running match cannot honour is still
+   * refused there). `gear` = the absolute bonus (0 / null clears it, the four gears +1/+10/+100/+999). Idempotent: the
+   * same gear a second time moves nothing. The seats' layers are authoritative on the server, so the change reaches
+   * every player (and bot) the next time its boards / bonds / battles are built.
+   * @param {number|null} gear
+   * @returns {{ gear: number, moved: number }} how many bonds moved (across all seats)
+   */
+  applySandboxBondLayers(gear) {
+    const to = Number.isInteger(gear) && gear > 0 ? gear : 0;
+    this.sandbox = this.sandbox ? { ...this.sandbox, bondLayers: to || null } : { ...EMPTY_SANDBOX, bondLayers: to || null, inert: false };
+    this.gd.sandbox = this.sandbox;
+    let moved = 0;
+    for (const ps of this.players.values()) {
+      if (typeof ps.applySandboxBondLayers === 'function') moved += ps.applySandboxBondLayers(to);
+    }
+    if (moved) this.markPublic();
+    return { gear: to, moved };
+  }
