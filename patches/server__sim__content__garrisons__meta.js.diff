+// ---------------------------------------------------------------------------------------------------------------------
+// MOD (罗德岛) — 可露希尔: "进入休整期时，若已激活【罗德岛】盟约，获得count名不高于当前调度中心等级的【罗德岛】干员"
+//
+// Fires once per board copy on the official SERVER_PREP_START hook (→ onRoundStart), so the ceiling is the number of
+// 可露希尔 standing on the board, not the player's purse. It used to be a SERVER_SPEND coin meter — every `bb.cost` (8)
+// funds spent granted `bb.count` (user design 2026-10-05) — which turned into an unbounded money pump: enough copies and
+// a single 休整期 spun the meter round and round (user playtest 2026-10-06, "电表倒转"). `bbStr.bond` doubles as the
+// "已激活" gate, `bbStr.tier === 'shoplv'` reads the CURRENT 调度中心等级 (upgraded by the player, never by the round),
+// and the operator is rolled off the SHARED pool (`ctx.rollChess({bond, maxTier})`) — so a tier the pool has nothing left
+// in simply yields fewer operators: the ceiling is a filter, never a guarantee. `conditionkey: character_target_inboard`
+// keeps it a board trait (the dispatcher skips hand copies).
+H.modautochess_gar_prep_gain_chess_by_bond = {
+  run(ctx) {
+    const { bb, bbStr } = ctx.source;
+    const bond = ids(bbStr.bond)[0];
+    if (!bond || !ctx.bondActive(bond)) return;
+    const n = Math.min(10, Math.max(0, num(bb.count, 1)));
+    const maxTier = bbStr.tier === 'shoplv' ? ctx.shopLevel() : Math.max(1, Math.min(6, num(bb.max_tier, 6)));
+    for (let i = 0; i < n; i++) {
+      const id = ctx.rollChess({ bond, maxTier });
+      if (id) ctx.grantChess(id);
+    }
+  },
+};
